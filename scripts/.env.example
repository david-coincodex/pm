# Copy to scripts/.env and fill in. Gitignored — never commit the real file.

# ── Local Strapi (what most scripts read/write) ───────────────────────────────
STRAPI_URL=http://localhost:1339
# Strapi API token: admin -> Settings -> API Tokens. Needs write access for the importers.
STRAPI_TOKEN=

# ── Content generation ────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Optional price overrides for the cost estimates printed by the generators (USD per 1M tokens).
# OPENAI_PRICE_GPT55_IN=1.25
# OPENAI_PRICE_GPT55_OUT=10

# ── Staging (scripts/sync-content-to-staging.mjs) ─────────────────────────────
# Cloudflare Access service token. cms-staging.pornmode.com sits behind a CF Access
# application, so every request needs these two headers or it answers 302 to a login page.
# Zero Trust dashboard -> Access -> Service Auth. If unset, the sync script falls back to
# frontend/.env.local.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# A staging Strapi API token. Optional: without it, staging comparisons are PUBLISHED-ONLY,
# because reading `?status=draft` requires authentication. Set it for a complete comparison.
STAGING_STRAPI_TOKEN=

# The staging TRANSFER token lives in backend/.env as STAGING_TRANSFER_TOKEN, not here —
# see backend/.env.example and scripts/sync-content-to-staging.md.
