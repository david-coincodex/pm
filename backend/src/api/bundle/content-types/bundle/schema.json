{
  "kind": "collectionType",
  "collectionName": "bundles",
  "info": {
    "singularName": "bundle",
    "pluralName": "bundles",
    "displayName": "Bundle",
    "description": "A curated bundle of sites",
    "mainField": "name"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "sites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::site.site",
      "required": true
    },
    "description": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "content": {
      "type": "blocks",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "included": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "offers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::offer.offer",
      "mappedBy": "bundle"
    }
  }
}
