{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site",
    "description": "Unified content type for all site categories",
    "mainField": "name"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      },
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "siteType": {
      "type": "enumeration",
      "enum": ["paysite", "camsite", "datingsite", "tubesite"],
      "required": true
    },
    "typeDetails": {
      "type": "dynamiczone",
      "components": [
        "site-details.pay-site-details",
        "site-details.cam-site-details",
        "site-details.dating-site-details",
        "site-details.tube-site-details"
      ],
      "max": 1
    },
    "short_description": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "included": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "offers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::offer.offer",
      "mappedBy": "site"
    },
    "parent_site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "child_sites"
    },
    "child_sites": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::site.site",
      "mappedBy": "parent_site"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "sites"
    },
    "platform": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::platform.platform",
      "inversedBy": "sites"
    },
    "reviewSources": {
      "type": "component",
      "repeatable": true,
      "component": "review.review-source"
    },
    "scrapedReviews": {
      "type": "json"
    },
    "externalContext": {
      "type": "json"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
