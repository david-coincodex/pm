      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "metaTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "metaDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "content": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": { "localized": true }
