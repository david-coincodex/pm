HOST=0.0.0.0
PORT=1339
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Frontend CORS origin
FRONTEND_URL=http://localhost:3002

# ── Content sync to staging (scripts/sync-content-to-staging.mjs) ────────────
# A Strapi TRANSFER token (not an API token), minted in the staging admin under
# Settings -> Global settings -> Transfer Tokens. Regenerating TRANSFER_TOKEN_SALT on
# staging invalidates every existing transfer token.
# The URL is behind Cloudflare Access, so `strapi transfer` cannot reach it directly; the
# sync script proxies through scripts/lib/cf-access-proxy.mjs. See
# scripts/sync-content-to-staging.md.
STAGING_TRANSFER_URL=https://cms-staging.pornmode.com
STAGING_TRANSFER_TOKEN=

# Shared secret guarding POST /api/cam-models/sync (feed roster upserts from the frontend)
CAM_SYNC_SECRET=tobemodified

# Healthchecks.io heartbeats for the cron jobs + roster sync (docs/monitoring.md).
# Unset => pings are skipped (crons still run). Slug prefix names the environment in the
# shared Healthchecks project; deployed composes hardcode staging/prod, dev defaults to "dev".
HEALTHCHECKS_PING_KEY=
HEALTHCHECKS_SLUG_PREFIX=dev
